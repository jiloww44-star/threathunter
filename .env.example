# ThreatHunter360 environment — spec Part 1.2 / Part 9.2 secret management.
# Copy to .env (never commit real secrets; production uses Vault/KMS).

TH360_ENV=demo                      # demo | production
DATABASE_URL=sqlite:///backend/th360_demo.db
TH360_DATABASE_PATH=backend/th360_demo.db
REDIS_URL=redis://localhost:6379/0

# Production source credentials (Part 1.2) — empty in demo profile
OPENWEATHER_KEY=
TRAFFIC_API_KEY=
THREAT_INTEL_TOKEN=

# KYC PII encryption (Fernet in production; rotate quarterly)
KYC_ENCRYPTION_KEY=demo-insecure-key

# API limits & behavior
MAX_CLAIM_LENGTH=280
TH360_SOURCES_FILE=seed/sources_demo.yaml
TH360_LOG_LEVEL=INFO
TH360_CORS_ORIGINS=http://localhost:5173

# Demo enterprise key (spec Part 13.6)
TH360_DEMO_API_KEY=sk_demo_threathunter360

# ── Free-Tier Stack Integration (spec §Free-Tier) ────────────────────────
# Firecrawl — evidence sourcing (~500 credits/mo free tier, §2.4 budget guarded)
FIRECRAWL_API_KEY=
# OpenRouter — AI actions for factcheck/journey/kyc narratives (§3)
OPENROUTER_API_KEY=
TH360_SITE_URL=https://threathunter360.com
# OSM stack needs NO key (Nominatim/OSRM/Leaflet are keyless).
# Force fixture mode (e.g. offline demo or CI):
TH360_OFFLINE=false

# ── Self-Hosted Geo Stack (spec §Self-Hosted 1.2-1.3) ─────────────────────
# Leave blank/unset → public endpoints (1 req/s fair-use, no SLA).
# After `docker compose -f docker-compose.geo.yml up -d`, point the services
# at the local instances (zero code change; concurrency lifts automatically):
GEO_NOMINATIM_URL=            # e.g. http://th360-nominatim:8080
GEO_OSRM_URL=                 # e.g. http://th360-osrm:5000
# Only needed by the geo compose file itself (Nominatim's Postgres import):
NOMINATIM_PG_PASSWORD=        # required when using docker-compose.geo.yml
# Override the regional OSM extract (Geofabrik 50MB–2GB; default Nigeria):
GEO_PBF_URL=
